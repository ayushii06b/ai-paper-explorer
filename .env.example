# ==============================================================================
# AI Research Paper Explorer - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the actual .env file with real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (Neon PostgreSQL Hosted or Local)
# ------------------------------------------------------------------------------
# Hosted PostgreSQL connection string (Recommended: Neon, Supabase, Render):
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-xyz.us-east-2.aws.neon.tech/neondb?sslmode=require

# Local PostgreSQL parameters (used only if DATABASE_URL is not set):
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ai_paper_explorer
DB_USER=postgres
DB_PASSWORD=your_local_password_here

# ------------------------------------------------------------------------------
# 2. Groq Cloud API Configuration (Grounded RAG Answer Generation)
# ------------------------------------------------------------------------------
# Free developer API key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# Primary fast high-capacity model:
GROQ_MODEL=llama-3.3-70b-versatile

# Automatic fallback model for rate-limit protection:
FALLBACK_GROQ_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# 3. Server & CORS Configuration
# ------------------------------------------------------------------------------
# Comma-separated list of allowed frontend origins (e.g. your Vercel deployment URL)
# Use * for open access during development:
ALLOWED_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000,http://localhost:5173

# Port for FastAPI backend service (defaults to 8000 locally, 7860 on Hugging Face Spaces):
PORT=8000

# Maximum new tokens to generate per answer:
MAX_NEW_TOKENS=500
