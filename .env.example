# Local PostgreSQL Connection Parameters
DB_HOST=localhost
DB_PORT=5433
DB_NAME=ai_paper_explorer
DB_USER=postgres
DB_PASSWORD=your_local_password_here

# Cloud Hosted Database (Render, Neon, Supabase, Railway)
# If DATABASE_URL is set, it overrides the individual DB_* settings above:
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Server Runtime Configuration
PORT=8000
MAX_NEW_TOKENS=40
